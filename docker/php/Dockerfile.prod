# syntax=docker/dockerfile:1
# ============================================================
# Imagen de PRODUCCIÓN (monolito): nginx + php-fpm + queue + scheduler
# Construida UNA vez en CI y publicada en GHCR. El server solo hace pull.
# ============================================================

# ------------------------------------------------------------
# Stage 1: Assets frontend (Vite)
# NOTA: glibc (bookworm), NO alpine. Tailwind v4 (@tailwindcss/oxide +
# lightningcss) usa binarios nativos que fallan en musl/alpine.
# Este stage es descartable: no afecta el tamaño de la imagen final.
# ------------------------------------------------------------
FROM node:20-bookworm-slim AS node-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ------------------------------------------------------------
# Stage 2: Dependencias PHP (Composer, sin dev)
# ------------------------------------------------------------
FROM composer:2 AS composer-builder
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --optimize-autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

# ------------------------------------------------------------
# Stage 3: Runtime PHP-FPM + Nginx + Supervisor
# ------------------------------------------------------------
FROM php:8.4-fpm-alpine

# Dependencias de sistema (solo runtime) + extensiones PHP
RUN apk add --no-cache \
        curl \
        libpng \
        oniguruma \
        libxml2 \
        libzip \
        mysql-client \
        supervisor \
        nginx \
    && apk add --no-cache --virtual .build-deps \
        libpng-dev \
        oniguruma-dev \
        libxml2-dev \
        libzip-dev \
        linux-headers \
        $PHPIZE_DEPS \
    && docker-php-ext-configure zip \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd opcache zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

# Configuraciones
COPY docker/php/php.ini            /usr/local/etc/php/conf.d/custom.ini
COPY docker/nginx/nginx.conf       /etc/nginx/nginx.conf
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisor/supervisord.conf /etc/supervisord.conf

WORKDIR /var/www/html

# Dependencias ya construidas + código + assets compilados
COPY --from=composer-builder --chown=www-data:www-data /app/vendor ./vendor
COPY --chown=www-data:www-data . .
COPY --from=node-builder --chown=www-data:www-data /app/public/build ./public/build

# Directorios de runtime + permisos
RUN mkdir -p \
        storage/framework/sessions \
        storage/framework/views \
        storage/framework/cache \
        storage/logs \
        bootstrap/cache \
        /var/log/supervisor \
        /var/log/nginx \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Entrypoint: prepara caché de Laravel con el entorno real en cada arranque
COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

EXPOSE 80

ENTRYPOINT ["entrypoint"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
